{
  "name": "study-anchor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first student workspace desktop application",
  "main": "./out/main/index.js",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "predev": "node scripts/electron-dev-preflight.mjs",
    "dev": "electron-vite dev",
    "predev:compat": "node scripts/electron-dev-preflight.mjs",
    "dev:compat": "electron-vite dev --noSandbox",
    "doctor:electron": "node scripts/electron-dev-preflight.mjs",
    "setup:electron": "install-electron --no",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test scripts/sync-rls-acceptance.node.mjs scripts/supabase-alpha-preflight.node.mjs && node --test scripts/verify-downloaded-alpha.node.mjs && node --test scripts/alpha-readiness.node.mjs && node --test scripts/electron-dev-preflight.node.mjs && node --test scripts/file-sync-rls-acceptance.node.mjs",
    "test:sync-rls": "node --test scripts/sync-rls-acceptance.node.mjs",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm test && electron-vite build && node scripts/verify-offline-worker.mjs",
    "preview": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "preflight:supabase": "node scripts/supabase-alpha-preflight.mjs",
    "verify:alpha-artifact": "node scripts/verify-downloaded-alpha.mjs",
    "alpha:evidence:init": "node scripts/alpha-readiness.mjs init",
    "alpha:evidence:check": "node scripts/alpha-readiness.mjs check",
    "alpha:rehearsal": "vitest run src/main/alpha-release-rehearsal.test.ts",
    "test:file-rls:offline": "node --test scripts/file-sync-rls-acceptance.node.mjs",
    "test:file-rls:live": "node scripts/file-sync-rls-acceptance.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "org.studyanchor.desktop",
    "productName": "Study Anchor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "scripts/neural-inference-worker.py",
        "to": "neural-inference-worker.py"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education"
    }
  }
}
